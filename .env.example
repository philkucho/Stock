# Webull OpenAPI credentials (developer.webull.com 신청)
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here
WEBULL_REGION=us
# Paper trading 모드: true / false
WEBULL_PAPER=true

# FastAPI 백엔드
API_HOST=127.0.0.1
API_PORT=8000

# 로깅
LOG_LEVEL=INFO

# 데이터베이스 (Postgres + TimescaleDB)
# docker-compose.yml의 db 서비스와 동일 자격증명
DATABASE_URL=postgresql+asyncpg://stock:stock@localhost:5432/stock
# Alembic용 sync URL (마이그레이션 실행 시 사용)
DATABASE_URL_SYNC=postgresql+psycopg://stock:stock@localhost:5432/stock

# Daily email report (scripts/daily_email_report.py)
# Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 발급 (16자, 공백 제거하고 입력)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 수신자 (콤마 구분 다중). 미지정 시 GMAIL_USER 본인에게 발송
EMAIL_TO=your_email@gmail.com

# ── Alpaca paper auto-trade ──
ALPACA_API_KEY=PK...
ALPACA_API_SECRET=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
BROKER_ADAPTER=alpaca
# 마스터 kill switch — true 시 실제 paper 주문 발송, false면 dry-run
AUTO_TRADE_ENABLED=false

# ── Daily Loss Limit (circuit breaker) ──
# 전일 close 대비 NAV 변동률(%) 임계값. 부호 음수.
# halt: 신규 진입 차단 (기존 OCO 유지). close: alert + AUTO_CLOSE 시 강제 청산.
DAILY_LOSS_HALT_PCT=-3.0
DAILY_LOSS_CLOSE_PCT=-5.0
# close_pct 도달 시 자동 강제 청산 여부 (기본 false = alert only, 수동 청산 권장)
DAILY_LOSS_AUTO_CLOSE=false

# ── Sector Concentration Cap ──
# trade_plans 발송 시 동일 섹터 최대 N종목 (반도체에 5개 몰림 방지)
SECTOR_CAP=2

# ── Heartbeat Alerting ──
# daily_pipeline 각 phase 시작/완료/실패 시 이메일 ping 발송 (silent failure 방지)
# false면 logger.info만, true면 GMAIL_USER/GMAIL_APP_PASSWORD 사용해 EMAIL_TO에 발송
HEARTBEAT_ENABLED=false

# ── AI Advisor (LLM provider 선택) ──
# google    : Gemini 2.5 Pro (무료 티어, 기본 권장)
# anthropic : Claude Opus 4.7 / Sonnet 4.6 (유료, prompt caching으로 절감)
ADVISOR_PROVIDER=google
# 선택한 provider에 맞는 모델 (google: gemini-2.5-pro / gemini-2.5-flash / anthropic: claude-opus-4-7 / claude-sonnet-4-6)
ADVISOR_MODEL=gemini-2.5-pro
# Provider별 API 키 — 사용하는 쪽 한 개만 채우면 됨.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# 사용자 승인 TTL (초). 만료 시 status='expired'로 자동 무효 — 절대 자동 실행 X.
ADVISOR_APPROVAL_TTL_SEC=300
# 자문 활성화 마스터 스위치. false면 morning_brief / intraday 모두 dry-run.
ADVISOR_ENABLED=false
# intraday monitor에서 confidence < N 추천은 Telegram 보내지 않고 DB만 로깅.
ADVISOR_INTRADAY_MIN_CONFIDENCE=0.6

# ── Telegram Bot (advisor 알림 채널) ──
# @BotFather에서 봇 만든 후 발급. webhook은 별도로 설정 필요:
#   curl -F "url=https://your-domain/api/telegram/webhook" \
#        https://api.telegram.org/bot<TOKEN>/setWebhook
TELEGRAM_BOT_TOKEN=...
# 봇과 첫 채팅 후 getUpdates로 확인. 추천은 이 chat_id로만 전송.
TELEGRAM_CHAT_ID=...
# Webhook 검증 secret. setWebhook 시 secret_token 으로 등록.
TELEGRAM_WEBHOOK_SECRET=
